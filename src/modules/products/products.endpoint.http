@productId = {{ 'f1ca2ddd-d082-41c9-9259-7f6eff738ee5' }}
@categoryId = {{ '65f463dc-5238-433f-abd4-a18fdfdd96f4' }}

### Create product
POST http://localhost:3000/products
Content-Type: application/json

{
  "name": "Product 4",
  "description": "Product 4 description",
  "price": 150,
  "categoryId": "{{categoryId}}"
}

### Get all products
GET http://localhost:3000/products
Content-Type: application/json

### Get a product by id
GET http://localhost:3000/products/{{productId}}
Content-Type: application/json

### Update a product
PATCH http://localhost:3000/products/{{productId}}
Content-Type: application/json

{
  "price": 200
}

### Mark product unavailable (soft — cart assess returns UNAVAILABLE)
DELETE http://localhost:3000/products/{{productId}}
Content-Type: application/json

### Re-enable a product
PATCH http://localhost:3000/products/{{productId}}
Content-Type: application/json

{
  "isAvailable": true
}
