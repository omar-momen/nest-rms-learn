@productId = {{ '9971dc5f-5d21-4d32-8146-3766515d549b' }}
@categoryId = {{ '6db15747-bb44-4523-9b74-0cad121cd60e' }}

### Create product
POST {{host}}/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Product 1",
  "description": "Product 1 description",
  "price": 150,
  "categoryId": "{{categoryId}}"
}

### Get all products
GET {{host}}/products
Authorization: Bearer {{token}}

### Get a product by id
GET {{host}}/products/{{productId}}
Authorization: Bearer {{token}}

### Update a product
PATCH {{host}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "price": 200
}

### Mark product unavailable (soft — cart assess returns UNAVAILABLE)
DELETE {{host}}/products/{{productId}}
Authorization: Bearer {{token}}

### Re-enable a product
PATCH {{host}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "isAvailable": true
}
