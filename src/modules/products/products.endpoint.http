# Replace with ids from your own DB — a branchId that does not exist now returns 404.
@productId = {{ '8583077c-fc8a-4e08-9cc8-00eab3acf901' }}
@categoryId = {{ '9a898260-80c1-4928-b220-1e2d4cdade02' }}
@branchId = {{ '18b1e256-c8b0-4108-9a00-2be212ce5abc' }}

### App: list products (optional branch stock)
GET {{host}}/app/products?branchId={{branchId}}
Authorization: Bearer {{token}}

### App: get a product by id
GET {{host}}/app/products/{{productId}}?branchId={{branchId}}
Authorization: Bearer {{token}}

### Dashboard: create product
POST {{host}}/dashboard/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Product 1",
  "description": "Product 1 description",
  "price": "150.00",
  "categoryId": "{{categoryId}}"
}

### Dashboard: list products
GET {{host}}/dashboard/products?branchId={{branchId}}
Authorization: Bearer {{token}}

### Dashboard: get a product
GET {{host}}/dashboard/products/{{productId}}?branchId={{branchId}}
Authorization: Bearer {{token}}

### Dashboard: update a product
PATCH {{host}}/dashboard/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "price": "200.00"
}

### Dashboard: mark product unavailable
DELETE {{host}}/dashboard/products/{{productId}}
Authorization: Bearer {{token}}

### Dashboard: re-enable a product
PATCH {{host}}/dashboard/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "isAvailable": true
}
