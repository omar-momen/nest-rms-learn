@orderId = {{'0a07eb09-399a-48cb-bfda-9e7be7d8f7f2'}}

### App: create order (uses current user's cart)
POST {{host}}/app/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "couponCode": "SAVE10",
  "loyaltyPointsAmount": 100,
  "type": "DELIVERY",
  "branchId": "00000000-0000-0000-0000-000000000001",
  "addressId": "00000000-0000-0000-0000-000000000002",
  "paymentMethod": "CARD"
}

### App: list own orders
GET {{host}}/app/orders
Authorization: Bearer {{token}}

### App: get own order by id
GET {{host}}/app/orders/{{orderId}}
Authorization: Bearer {{token}}

### App: cancel order (PENDING → CANCELLED)
PATCH {{host}}/app/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}

### App: delete order (PENDING only)
DELETE {{host}}/app/orders/{{orderId}}
Authorization: Bearer {{token}}

### Dashboard: list all orders
GET {{host}}/dashboard/orders
Authorization: Bearer {{token}}

### Dashboard: get any order
GET {{host}}/dashboard/orders/{{orderId}}
Authorization: Bearer {{token}}

### Dashboard: confirm order (PENDING → CONFIRMED)
PATCH {{host}}/dashboard/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "CONFIRMED"
}

### Dashboard: complete order (CONFIRMED → COMPLETED)
PATCH {{host}}/dashboard/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "COMPLETED"
}

### Dashboard: cancel via status
PATCH {{host}}/dashboard/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "CANCELLED"
}
